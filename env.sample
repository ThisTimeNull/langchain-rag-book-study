# 이 파일을 복사해서 .env 로 만들고 실제 키를 채우세요:  cp env.sample .env
# .env 는 .gitignore 에 의해 커밋되지 않습니다.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- DeepSeek ---
# 발급: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Neo4j (GraphRAG) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# --- Azure AI Foundry (koreacentral / rg-langchain-rag-book) ---
AZURE_OPENAI_ENDPOINT=https://aif-langchain-rag-book.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=여기에-키
AZURE_OPENAI_DEPLOYMENT=gpt-5-4-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2025-04-01-preview
